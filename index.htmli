<!DOCTYPE html>
<html lang="es" class="scroll-smooth">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Portafolio de Renderizado 3D & Visualización</title>
    <!-- Tailwind CSS para el diseño y estilos -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Iconos FontAwesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        /* Personalización de colores oscuros para la estética de renderizado */
        body {
            background-color: #0b0f19;
            color: #f3f4f6;
        }
    </style>
</head>
<body class="font-sans antialiased selection:bg-blue-500 selection:text-white">

    <!-- MENÚ DE NAVEGACIÓN -->
    <header class="fixed top-0 left-0 w-full bg-[#0b0f19]/90 backdrop-blur-md z-50 border-b border-gray-800">
        <div class="max-w-7xl mx-auto px-6 h-20 flex items-center justify-between">
            <a href="#" class="text-xl font-bold tracking-wider text-white">
                <span class="text-blue-500">3D</span>STUDIO
            </a>
            <nav class="hidden md:flex space-x-8 text-sm font-medium tracking-wide">
                <a href="#inicio" class="text-gray-300 hover:text-blue-400 transition">Inicio</a>
                <a href="#mis-trabajos" class="text-gray-300 hover:text-blue-400 transition">Mis Trabajos</a>
                <a href="#dejame-saber" class="text-gray-300 hover:text-blue-400 transition">Déjame Saber</a>
            </nav>
            <!-- Botón de acción rápido -->
            <a href="#dejame-saber" class="px-5 py-2.5 bg-blue-600 hover:bg-blue-700 text-white text-sm font-semibold rounded-lg transition duration-300 shadow-lg shadow-blue-500/20">
                Iniciar Proyecto
            </a>
        </div>
    </header>

    <!-- PORTADA / HERO SECTION -->
    <section id="inicio" class="pt-32 pb-20 px-6 max-w-7xl mx-auto">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
            
            <!-- Texto de Presentación -->
            <div class="lg:col-span-5 space-y-6">
                <span class="text-blue-500 font-semibold tracking-wider uppercase text-sm">Visualización 3D & Renderizado</span>
                <h1 class="text-4xl md:text-5xl font-extrabold tracking-tight leading-tight text-white">
                    Dando vida a tus ideas en cualquier industria
                </h1>
                <p class="text-gray-400 text-lg leading-relaxed">
                    Especializado en la creación de imágenes y animaciones fotorrealistas para arquitectura, publicidad, diseño de producto y entornos audiovisuales. Convirtiendo conceptos técnicos o creativos en renders de alta calidad.
                </p>
                <div class="pt-4 flex flex-wrap gap-4">
                    <a href="#mis-trabajos" class="px-6 py-3 bg-gray-800 hover:bg-gray-700 text-white font-medium rounded-lg transition border border-gray-700">
                        Ver Portafolio
                    </a>
                    <a href="#dejame-saber" class="px-6 py-3 bg-blue-600 hover:bg-blue-700 text-white font-medium rounded-lg transition">
                        Contáctame
                    </a>
                </div>
            </div>

            <!-- Muestra visual de habilidades en la Portada (Múltiples imágenes/renders) -->
            <div class="lg:col-span-7 grid grid-cols-12 gap-4">
                <!-- Imagen Principal Grande -->
                <div class="col-span-8 overflow-hidden rounded-2xl border border-gray-800 group relative">
                    <img src="https://images.unsplash.com/photo-1600585154340-be6161a56a0c?auto=format&fit=crop&w=800&q=80" alt="Visualización Arquitectónica" class="w-full h-80 object-cover transform group-hover:scale-105 transition duration-500">
                    <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-transparent to-transparent p-6 flex items-end">
                        <div>
                            <span class="text-xs font-semibold bg-blue-600 px-2 py-1 rounded text-white uppercase">Arquitectura</span>
                            <h3 class="text-lg font-bold text-white mt-1">Interiores y Exteriores</h3>
                        </div>
                    </div>
                </div>
                <!-- Imagen Secundaria Superior Derecha -->
                <div class="col-span-4 overflow-hidden rounded-2xl border border-gray-800 group relative">
                    <img src="https://images.unsplash.com/photo-1618005182384-a83a8bd57fbe?auto=format&fit=crop&w=600&q=80" alt="Modelado Abstracto 3D" class="w-full h-80 object-cover transform group-hover:scale-105 transition duration-500">
                    <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-transparent to-transparent p-4 flex items-end">
                        <div>
                            <span class="text-[10px] font-semibold bg-purple-600 px-2 py-1 rounded text-white uppercase">Arte 3D</span>
                        </div>
                    </div>
                </div>
                <!-- Imagen Inferior Izquierda -->
                <div class="col-span-4 overflow-hidden rounded-2xl border border-gray-800 group relative">
                    <img src="https://images.unsplash.com/photo-1508739773434-c26b3d09e071?auto=format&fit=crop&w=600&q=80" alt="Render de Entornos Cinematográficos" class="w-full h-48 object-cover transform group-hover:scale-105 transition duration-500">
                    <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-transparent to-transparent p-4 flex items-end">
                        <div>
                            <span class="text-[10px] font-semibold bg-green-600 px-2 py-1 rounded text-white uppercase">Audiovisual</span>
                        </div>
                    </div>
                </div>
                <!-- Imagen Inferior Derecha Grande -->
                <div class="col-span-8 overflow-hidden rounded-2xl border border-gray-800 group relative">
                    <img src="https://images.unsplash.com/photo-1581092160607-ee22621dd758?auto=format&fit=crop&w=800&q=80" alt="Render de Producto / CGI" class="w-full h-48 object-cover transform group-hover:scale-105 transition duration-500">
                    <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-transparent to-transparent p-4 flex items-end">
                        <div>
                            <span class="text-xs font-semibold bg-orange-600 px-2 py-1 rounded text-white uppercase">CGI / Producto</span>
                            <h3 class="text-base font-bold text-white mt-0.5">Modelado de Alta Precisión</h3>
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </section>

    <!-- SECCIÓN: MIS TRABAJOS (PORTAFOLIO) -->
    <section id="mis-trabajos" class="py-24 bg-[#080b13] border-t border-b border-gray-900">
        <div class="max-w-7xl mx-auto px-6">
            <div class="text-center max-w-3xl mx-auto mb-16">
                <span class="text-blue-500 font-semibold tracking-wider uppercase text-sm">Portafolio</span>
                <h2 class="text-3xl md:text-4xl font-bold text-white mt-2">Mis Trabajos Recientes</h2>
                <p class="text-gray-400 mt-4">
                    Una selección de proyectos desarrollados para diferentes sectores. Cada imagen representa un enfoque en el realismo físico, la iluminación y la atención al detalle.
                </p>
            </div>

            <!-- Galería de Proyectos -->
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
                
                <!-- Trabajo 1 -->
                <div class="bg-[#111625] rounded-xl overflow-hidden border border-gray-800 hover:border-blue-500/50 transition duration-300 flex flex-col justify-between">
                    <div>
                        <div class="h-56 overflow-hidden">
                            <img src="https://images.unsplash.com/photo-1512917774080-9991f1c4c750?auto=format&fit=crop&w=600&q=80" alt="Villa Residencial Moderna" class="w-full h-full object-cover hover:scale-105 transition duration-500">
                        </div>
                        <div class="p-6">
                            <h3 class="text-xl font-bold text-white">Villa Residencial Moderna</h3>
                            <p class="text-gray-400 mt-2 text-sm">
                                Renderizado exterior con iluminación natural y vegetación realista para estudio de arquitectura.
                            </p>
                        </div>
                    </div>
                    <div class="px-6 pb-6 pt-2 flex flex-wrap gap-2">
                        <span class="text-xs bg-gray-800 text-gray-300 px-2.5 py-1 rounded">V-Ray</span>
                        <span class="text-xs bg-gray-800 text-gray-300 px-2.5 py-1 rounded">3ds Max</span>
                        <span class="text-xs bg-gray-800 text-gray-300 px-2.5 py-1 rounded">Photoshop</span>
                    </div>
                </div>

                <!-- Trabajo 2 -->
                <div class="bg-[#111625] rounded-xl overflow-hidden border border-gray-800 hover:border-blue-500/50 transition duration-300 flex flex-col justify-between">
                    <div>
                        <div class="h-56 overflow-hidden">
                            <img src="https://images.unsplash.com/photo-1505740420928-5e560c06d30e?auto=format&fit=crop&w=600&q=80" alt="CGI de Producto Tecnológico" class="w-full h-full object-cover hover:scale-105 transition duration-500">
                        </div>
                        <div class="p-6">
                            <h3 class="text-xl font-bold text-white">CGI de Auriculares Premium</h3>
                            <p class="text-gray-400 mt-2 text-sm">
                                Renderizado publicitario de producto destacando texturas de metal y cuero para campaña digital.
                            </p>
                        </div>
                    </div>
                    <div class="px-6 pb-6 pt-2 flex flex-wrap gap-2">
                        <span class="text-xs bg-gray-800 text-gray-300 px-2.5 py-1 rounded">Blender</span>
                        <span class="text-xs bg-gray-800 text-gray-300 px-2.5 py-1 rounded">Cycles</span>
                        <span class="text-xs bg-gray-800 text-gray-300 px-2.5 py-1 rounded">Substance Painter</span>
                    </div>
                </div>

                <!-- Trabajo 3 -->
                <div class="bg-[#111625] rounded-xl overflow-hidden border border-gray-800 hover:border-blue-500/50 transition duration-300 flex flex-col justify-between">
                    <div>
                        <div class="h-56 overflow-hidden">
                            <img src="https://images.unsplash.com/photo-1536440136628-849c177e76a1?auto=format&fit=crop&w=600&q=80" alt="Entorno para Cortometraje" class="w-full h-full object-cover hover:scale-105 transition duration-500">
                        </div>
                        <div class="p-6">
                            <h3 class="text-xl font-bold text-white">Entorno de Ciencia Ficción</h3>
                            <p class="text-gray-400 mt-2 text-sm">
                                Creación de escenarios tridimensionales y optimización de iluminación para escenas de cine y animación.
                            </p>
                        </div>
                    </div>
                    <div class="px-6 pb-6 pt-2 flex flex-wrap gap-2">
                        <span class="text-xs bg-gray-800 text-gray-300 px-2.5 py-1 rounded">Unreal Engine 5</span>
                        <span class="text-xs bg-gray-800 text-gray-300 px-2.5 py-1 rounded">Quixel Megascans</span>
                    </div>
                </div>

            </div>
        </div>
    </section>

    <!-- SECCIÓN: CONTACTO / FORMULARIO -->
    <section id="dejame-saber" class="py-24 px-6 max-w-4xl mx-auto">
        <div class="bg-[#111625] border border-gray-800 rounded-3xl p-8 md:p-12 shadow-2xl relative overflow-hidden">
            <!-- Detalle decorativo en el fondo -->
            <div class="absolute -top-12 -right-12 w-40 h-40 bg-blue-500/10 rounded-full blur-3xl"></div>
            
            <div class="text-center md:text-left mb-8">
                <span class="text-blue-500 font-semibold tracking-wider uppercase text-sm">Colaboraciones</span>
                <h2 class="text-3xl font-bold text-white mt-2">Déjame Saber</h2>
                <p class="text-gray-400 mt-2">
                    ¿Tienes una idea en mente, un plano arquitectónico o un proyecto audiovisual que requiere renderizado? Escríbeme y evaluemos cómo trabajarlo juntos.
                </p>
            </div>

            <!-- Formulario de contacto conectado con Formspree -->
            <form id="contactForm" action="https://formspree.io/f/TU_CORREO@DOMINIO.COM" method="POST" class="space-y-6">
                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    <div>
                        <label for="nombre" class="block text-sm font-medium text-gray-300 mb-2">Tu Nombre</label>
                        <input type="text" id="nombre" name="nombre" required class="w-full bg-[#0b0f19] border border-gray-700 rounded-lg px-4 py-3 text-white focus:outline-none focus:border-blue-500 transition">
                    </div>
                    <div>
                        <label for="correo" class="block text-sm font-medium text-gray-300 mb-2">Tu Correo Electrónico</label>
                        <input type="email" id="correo" name="correo" required class="w-full bg-[#0b0f19] border border-gray-700 rounded-lg px-4 py-3 text-white focus:outline-none focus:border-blue-500 transition">
                    </div>
                </div>

                <div>
                    <label for="tipo_proyecto" class="block text-sm font-medium text-gray-300 mb-2">Tipo de Proyecto / Industria</label>
                    <select id="tipo_proyecto" name="tipo_proyecto" class="w-full bg-[#0b0f19] border border-gray-700 rounded-lg px-4 py-3 text-gray-300 focus:outline-none focus:border-blue-500 transition">
                        <option value="arquitectura">Visualización Arquitectónica (ArchViz)</option>
                        <option value="audiovisual">Industria Audiovisual / Cine / Animación</option>
                        <option value="producto">Modelado y Renderizado de Producto (CGI)</option>
                        <option value="otro">Otro tipo de proyecto</option>
                    </select>
                </div>

                <div>
                    <label for="mensaje" class="block text-sm font-medium text-gray-300 mb-2">Cuéntame qué necesitas</label>
                    <textarea id="mensaje" name="mensaje" rows="5" required placeholder="Describe las ideas clave, planos disponibles, plazos o el estilo visual que buscas..." class="w-full bg-[#0b0f19] border border-gray-700 rounded-lg px-4 py-3 text-white focus:outline-none focus:border-blue-500 transition placeholder:text-gray-600"></textarea>
                </div>

                <div class="pt-2">
                    <button type="submit" class="w-full md:w-auto px-8 py-4 bg-blue-600 hover:bg-blue-700 text-white font-semibold rounded-lg transition duration-300 shadow-lg shadow-blue-500/20 flex items-center justify-center gap-2">
                        <span>Enviar Mensaje</span>
                        <i class="fa-solid fa-paper-plane text-sm"></i>
                    </button>
                </div>
            </form>

            <!-- Mensaje de confirmación -->
            <div id="formSuccess" class="hidden mt-6 p-4 bg-green-900/40 border border-green-500 text-green-200 rounded-lg text-center">
                ¡Gracias por escribirme! He recibido tus datos y me pondré en contacto contigo a la brevedad posible.
            </div>
            
            <!-- Mensaje de error -->
            <div id="formError" class="hidden mt-6 p-4 bg-red-900/40 border border-red-500 text-red-200 rounded-lg text-center">
                Hubo un problema al enviar tu mensaje. Por favor, inténtalo de nuevo.
            </div>
        </div>
    </section>

    <!-- FOOTER -->
    <footer class="bg-[#060810] border-t border-gray-900 py-12">
        <div class="max-w-7xl mx-auto px-6 flex flex-col md:flex-row items-center justify-between gap-6">
            <p class="text-sm text-gray-500">
                &copy; 2026 3DSTUDIO. Todos los derechos reservados.
            </p>
            <div class="flex space-x-6">
                <a href="#" class="text-gray-500 hover:text-white transition"><i class="fa-brands fa-artstation text-xl"></i></a>
                <a href="#" class="text-gray-500 hover:text-white transition"><i class="fa-brands fa-linkedin text-xl"></i></a>
                <a href="#" class="text-gray-500 hover:text-white transition"><i class="fa-brands fa-instagram text-xl"></i></a>
                <a href="#" class="text-gray-500 hover:text-white transition"><i class="fa-brands fa-vimeo text-xl"></i></a>
            </div>
        </div>
    </footer>

    <!-- SCRIPT DE COMPORTAMIENTO -->
    <script>
        const form = document.getElementById('contactForm');
        const successMessage = document.getElementById('formSuccess');
        const errorMessage = document.getElementById('formError');

        form.addEventListener('submit', async function(e) {
            e.preventDefault(); // Evita que la página se recargue de la forma tradicional
            
            const formData = new FormData(form);
            
            try {
                // Envía los datos de forma asíncrona a Formspree
                const response = await fetch(form.action, {
                    method: form.method,
                    body: formData,
                    headers: {
                        'Accept': 'application/json'
                    }
                });
                
                if (response.ok) {
                    // Si todo sale bien, muestra el éxito y limpia el formulario
                    successMessage.classList.remove('hidden');
                    errorMessage.classList.add('hidden');
                    form.reset();
                    
                    setTimeout(() => {
                        successMessage.classList.add('hidden');
                    }, 6000);
                } else {
                    // Si el servidor responde con un error
                    errorMessage.classList.remove('hidden');
                }
            } catch (error) {
                // Si hay un error de conexión de red
                errorMessage.classList.remove('hidden');
            }
        });
    </script>
</body>
</html>
